{
  "name": "mutation-guard",
  "version": "0.1.0",
  "description": "Client-side reliability for mutations: stable operation identity, idempotency keys, duplicate-execution protection, controlled retries, and recovery of uncertain outcomes.",
  "keywords": [
    "idempotency",
    "idempotency-key",
    "mutation",
    "retry",
    "recovery",
    "reconciliation",
    "duplicate-requests",
    "fetch",
    "axios",
    "indexeddb"
  ],
  "license": "MIT",
  "author": "Himesh Gunathilake",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "require": {
        "types": "./dist/storage.d.cts",
        "default": "./dist/storage.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist && npm run check:package",
    "test:dist": "node scripts/smoke.mjs && node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "axios": "^1.21.0",
    "fake-indexeddb": "^6.2.7",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
